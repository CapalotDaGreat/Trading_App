{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID": "Aithera Pro",
        "EXPO_PUBLIC_RC_PRODUCT_MONTHLY": "tradevision_premium_monthly",
        "EXPO_PUBLIC_RC_PRODUCT_YEARLY": "tradevision_premium_yearly",
        "EXPO_PUBLIC_RC_PRODUCT_LIFETIME": "tradevision_premium_lifetime"
      }
    },
    "internal": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID": "Aithera Pro",
        "EXPO_PUBLIC_RC_PRODUCT_MONTHLY": "tradevision_premium_monthly",
        "EXPO_PUBLIC_RC_PRODUCT_YEARLY": "tradevision_premium_yearly",
        "EXPO_PUBLIC_RC_PRODUCT_LIFETIME": "tradevision_premium_lifetime"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_MARKET_DATA_DIRECT": "false",
        "EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID": "Aithera Pro",
        "EXPO_PUBLIC_RC_PRODUCT_MONTHLY": "tradevision_premium_monthly",
        "EXPO_PUBLIC_RC_PRODUCT_YEARLY": "tradevision_premium_yearly",
        "EXPO_PUBLIC_RC_PRODUCT_LIFETIME": "tradevision_premium_lifetime"
      }
    },
    "beta": {
      "distribution": "internal",
      "channel": "beta",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_MARKET_DATA_DIRECT": "false",
        "EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID": "Aithera Pro",
        "EXPO_PUBLIC_RC_PRODUCT_MONTHLY": "tradevision_premium_monthly",
        "EXPO_PUBLIC_RC_PRODUCT_YEARLY": "tradevision_premium_yearly",
        "EXPO_PUBLIC_RC_PRODUCT_LIFETIME": "tradevision_premium_lifetime"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_MARKET_DATA_DIRECT": "false",
        "EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID": "Aithera Pro",
        "EXPO_PUBLIC_RC_PRODUCT_MONTHLY": "tradevision_premium_monthly",
        "EXPO_PUBLIC_RC_PRODUCT_YEARLY": "tradevision_premium_yearly",
        "EXPO_PUBLIC_RC_PRODUCT_LIFETIME": "tradevision_premium_lifetime"
      }
    }
  },
  "submit": {
    "production": {},
    "beta": {
      "ios": {
        "ascAppId": "REPLACE_WITH_ASC_APP_ID"
      }
    }
  }
}
