  "private": true,
  "scripts": {
    "start": "cross-env NODE_EXTRA_CA_CERTS=./certs/avg-web-mail-shield-root.pem expo start --host lan",
    "start:offline": "expo start --offline",
    "start:tunnel": "cross-env NODE_EXTRA_CA_CERTS=./certs/avg-web-mail-shield-root.pem expo start --tunnel",
