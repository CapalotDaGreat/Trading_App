{
  "name": "tradeacademy-ai",
  "main": "index.js",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "cross-env NODE_EXTRA_CA_CERTS=./certs/avg-web-mail-shield-root.pem NODE_USE_SYSTEM_CA=1 expo start --host lan --go",
    "start:dev-client": "cross-env NODE_EXTRA_CA_CERTS=./certs/avg-web-mail-shield-root.pem NODE_USE_SYSTEM_CA=1 expo start --host lan --dev-client",
    "start:offline": "cross-env NODE_EXTRA_CA_CERTS=./certs/avg-web-mail-shield-root.pem NODE_USE_SYSTEM_CA=1 EXPO_OFFLINE=1 expo start --offline --go",
    "start:tunnel": "cross-env NODE_EXTRA_CA_CERTS=./certs/avg-web-mail-shield-root.pem NODE_USE_SYSTEM_CA=1 expo start --tunnel --go",
    "android": "cross-env NODE_EXTRA_CA_CERTS=./certs/avg-web-mail-shield-root.pem NODE_USE_SYSTEM_CA=1 expo start --android --go",
    "ios": "cross-env NODE_EXTRA_CA_CERTS=./certs/avg-web-mail-shield-root.pem NODE_USE_SYSTEM_CA=1 expo start --ios --go",
    "web": "cross-env NODE_EXTRA_CA_CERTS=./certs/avg-web-mail-shield-root.pem NODE_USE_SYSTEM_CA=1 expo start --web",
    "export-ca": "powershell -ExecutionPolicy Bypass -File ./scripts/export-avg-ca.ps1",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:rules": "cross-env NODE_EXTRA_CA_CERTS=./certs/avg-web-mail-shield-root.pem NODE_USE_SYSTEM_CA=1 firebase emulators:exec --only firestore,storage \"cross-env NODE_OPTIONS=--experimental-vm-modules jest --config jest.rules.config.js --runInBand\"",
    "expo:config": "expo config --type public",
    "legal": "npm run legal:sync && npm run legal:host",
    "legal:sync": "python scripts/sync-legal-docs.py",
    "legal:host": "python scripts/build-hosted-legal.py",
    "functions:build": "npm --prefix functions run build",
    "functions:test": "npm --prefix functions test",
    "eas:dev-builds": "eas workflow:run .eas/workflows/create-development-builds.yml",
    "eas:preview-builds": "eas workflow:run .eas/workflows/create-preview-builds.yml",
    "eas:production-builds": "eas workflow:run .eas/workflows/create-production-builds.yml"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.74.4",
    "clsx": "^2.1.1",
    "expo": "^57.0.0",
    "expo-apple-authentication": "~57.0.2",
    "expo-application": "~57.0.3",
    "expo-auth-session": "~57.0.12",
    "expo-background-task": "~57.0.17",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "~57.0.18",
    "expo-router": "~57.0.21",
    "expo-screen-capture": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.17",
    "expo-updates": "~57.0.22",
    "expo-web-browser": "~57.0.3",
    "firebase": "^11.6.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.55.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-purchases": "^10.4.4",
    "react-native-purchases-ui": "^10.4.4",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.17",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.5.1",
    "@types/react": "~19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "babel-preset-expo": "~57.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.24.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "firebase-tools": "^15.24.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.5.3",
    "typescript": "~6.0.3"
  }
}
