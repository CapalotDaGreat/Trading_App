    "web": "cross-env NODE_EXTRA_CA_CERTS=./certs/avg-web-mail-shield-root.pem expo start --web",
    "export-ca": "powershell -ExecutionPolicy Bypass -File ./scripts/export-avg-ca.ps1",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
