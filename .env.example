# Firebase (omit all to run in demo mode)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# RevenueCat (REST API — works in Expo Go)
# Products: tradevision_premium_monthly, tradevision_premium_yearly
# Configure a 7-day introductory free trial on the yearly product in App Store Connect /
# Google Play Console and attach it in RevenueCat. Entitlement id should be "premium".
EXPO_PUBLIC_REVENUECAT_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=premium
EXPO_PUBLIC_REVENUECAT_WEB_CHECKOUT_URL=https://pay.rev.cat/checkout

# Market data (fallback to demo when absent)
# Free keys: https://finnhub.io/ — https://www.alphavantage.co/support/#api-key
EXPO_PUBLIC_FINNHUB_API_KEY=
EXPO_PUBLIC_ALPHA_VANTAGE_API_KEY=

# Cloud AI (optional — Premium uses cloud when configured, else local engine)
EXPO_PUBLIC_AI_API_URL=
# Or: EXPO_PUBLIC_FIREBASE_FUNCTIONS_URL=

# Expo / EAS
EXPO_PUBLIC_EAS_PROJECT_ID=

# API (optional)
EXPO_PUBLIC_API_BASE_URL=https://api.tradevision.ai/v1

# News (optional; falls back to RSS)
EXPO_PUBLIC_NEWS_API_KEY=
EXPO_PUBLIC_NEWS_RSS_URL=
