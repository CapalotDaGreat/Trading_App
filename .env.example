# Firebase (omit all to run in demo mode)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# RevenueCat native SDK (public app-specific SDK keys; never use a RevenueCat secret key here)
# Entitlement: "Aithera Pro"
# Products (attach all three to your current offering + Paywall in the RC dashboard):
#   monthly | yearly | lifetime
# Prefer platform keys in production. Shared EXPO_PUBLIC_REVENUECAT_API_KEY works for sandbox/test keys.
EXPO_PUBLIC_REVENUECAT_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=Aithera Pro
EXPO_PUBLIC_RC_PRODUCT_MONTHLY=monthly
EXPO_PUBLIC_RC_PRODUCT_YEARLY=yearly
EXPO_PUBLIC_RC_PRODUCT_LIFETIME=lifetime
# Optional hosted provider portal for non-App Store / Play Store subscriptions.
EXPO_PUBLIC_SUBSCRIPTION_PORTAL_URL=

# Market / news vendor keys — PRODUCTION: omit entirely.
# Signed-in users call Firebase Cloud Functions (FINNHUB_API_KEY / ALPHA_VANTAGE_API_KEY /
# NEWS_API_KEY set as Functions secrets). Guest/demo uses sample + public no-key APIs.
# Dev-only direct vendors (never ship in EAS production profiles):
# EXPO_PUBLIC_MARKET_DATA_DIRECT=true
# EXPO_PUBLIC_FINNHUB_API_KEY=
# EXPO_PUBLIC_ALPHA_VANTAGE_API_KEY=
# EXPO_PUBLIC_NEWS_API_KEY=

# App Check debug token for Expo Go / __DEV__ (register in Firebase Console → App Check)
EXPO_PUBLIC_APPCHECK_DEBUG_TOKEN=

# Google Sign-In (Expo Auth Session)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Expo / EAS
# UUID from `eas project:info`; leave empty for local/demo Expo config validation.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Expo account or organization that owns the linked project.
EAS_OWNER=

# Optional crash reporting. The app still requires explicit in-app consent and a
# supported signed EAS native client; Expo Go and web never initialize Sentry.
EXPO_PUBLIC_SENTRY_DSN=
# Build-time source-map upload secret. Configure only in EAS, never in EXPO_PUBLIC_*.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# API (optional legacy REST base — market/news prefer Cloud Functions)
EXPO_PUBLIC_API_BASE_URL=https://api.tradevision.ai/v1

# Public RSS fallback (no secret)
EXPO_PUBLIC_NEWS_RSS_URL=
