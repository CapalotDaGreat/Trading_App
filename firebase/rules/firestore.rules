rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedUser() {
      return isSignedIn()
        && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'anonymous');
    }

    function hasValidTimestamps() {
      return request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidUserProfile() {
      let data = request.resource.data;
      return data.keys().hasAll(['email', 'displayName', 'createdAt', 'updatedAt'])
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 500))
        && (!('currency' in data) || (data.currency is string && data.currency.size() == 3))
        && (!('timezone' in data) || data.timezone is string)
        && (!('experienceLevel' in data) || data.experienceLevel in ['beginner', 'intermediate', 'advanced', 'professional'])
        && (!('notificationsEnabled' in data) || data.notificationsEnabled is bool)
        && (!('mfaEnabled' in data) || data.mfaEnabled is bool)
        && (!('onboardingCompleted' in data) || data.onboardingCompleted is bool);
    }

    function isValidWatchlist() {
      let data = request.resource.data;
      return data.keys().hasAll(['name', 'symbols', 'createdAt', 'updatedAt'])
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 100
        && data.symbols is list
        && data.symbols.size() <= 100;
    }

    function isValidHolding() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'symbol', 'name', 'marketType', 'assetClass', 'quantity',
          'averageCost', 'currentPrice', 'currency', 'side', 'createdAt', 'updatedAt'
        ])
        && data.symbol is string
        && data.symbol.size() >= 1
        && data.symbol.size() <= 20
        && data.name is string
        && data.marketType in ['stocks', 'forex', 'crypto', 'commodities', 'indices', 'options']
        && data.assetClass in [
          'equity', 'etf', 'crypto', 'forex', 'commodity',
          'index', 'option', 'bond', 'futures'
        ]
        && data.quantity is number
        && data.quantity > 0
        && data.averageCost is number
        && data.currentPrice is number
        && data.currency is string
        && data.currency.size() == 3
        && data.side in ['long', 'short'];
    }

    function isValidJournalEntry() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'symbol', 'direction', 'entryPrice', 'quantity', 'outcome',
          'tags', 'notes', 'tradedAt', 'createdAt', 'updatedAt'
        ])
        && data.symbol is string
        && data.symbol.size() >= 1
        && data.symbol.size() <= 20
        && data.direction in ['long', 'short']
        && data.entryPrice is number
        && data.entryPrice >= 0
        && data.quantity is number
        && data.quantity > 0
        && data.outcome in ['win', 'loss', 'breakeven', 'open']
        && data.tags is list
        && data.tags.size() <= 20
        && data.notes is string
        && data.notes.size() <= 10000
        && data.tradedAt is string;
    }

    function isValidAlert() {
      let data = request.resource.data;
      return data.keys().hasAll(['symbol', 'condition', 'targetPrice', 'isActive', 'createdAt', 'updatedAt'])
        && data.symbol is string
        && data.symbol.size() >= 1
        && data.symbol.size() <= 20
        && data.condition in ['above', 'below', 'crosses']
        && data.targetPrice is number
        && data.targetPrice > 0
        && data.isActive is bool;
    }

    function isValidDecisionRecord() {
      let data = request.resource.data;
      return data.keys().hasAll(['symbol', 'regime', 'action', 'createdAt'])
        && data.symbol is string
        && data.symbol.size() >= 1
        && data.symbol.size() <= 20
        && data.regime is string
        && data.regime.size() <= 100
        && data.action in [
          'researched', 'skipped', 'journaled', 'opened', 'viewed', 'ignored',
          'invalidated', 'completed', 'brief_opened', 'alert_triggered',
          'portfolio_reviewed', 'ai_opened', 'replay_completed',
          'checklist_done', 'lab_opened', 'lab_closed'
        ]
        && data.createdAt is timestamp
        && (!('note' in data) || (data.note is string && data.note.size() <= 2000));
    }

    function isValidUserSettings() {
      let data = request.resource.data;
      return data.keys().hasAll(['theme', 'updatedAt'])
        && data.theme in ['light', 'dark', 'system']
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile() && hasValidTimestamps();
      allow update: if isOwner(userId) && isVerifiedUser() && isValidUserProfile();
      allow delete: if isOwner(userId);

      match /watchlists/{watchlistId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isVerifiedUser() && isValidWatchlist() && hasValidTimestamps();
        allow update: if isOwner(userId) && isVerifiedUser() && isValidWatchlist();
        allow delete: if isOwner(userId) && isVerifiedUser();
      }

      match /holdings/{positionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isVerifiedUser() && isValidHolding() && hasValidTimestamps();
        allow update: if isOwner(userId) && isVerifiedUser() && isValidHolding();
        allow delete: if isOwner(userId) && isVerifiedUser();
      }

      match /journal/{entryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isVerifiedUser() && isValidJournalEntry() && hasValidTimestamps();
        allow update: if isOwner(userId) && isVerifiedUser() && isValidJournalEntry();
        allow delete: if isOwner(userId) && isVerifiedUser();
      }

      match /alerts/{alertId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isVerifiedUser() && isValidAlert() && hasValidTimestamps();
        allow update: if isOwner(userId) && isVerifiedUser() && isValidAlert();
        allow delete: if isOwner(userId) && isVerifiedUser();
      }

      match /decisionLog/{recordId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isVerifiedUser() && isValidDecisionRecord();
        allow update, delete: if false;
      }
    }

    match /subscriptions/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /userSettings/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isVerifiedUser() && isValidUserSettings();
      allow delete: if isOwner(userId) && isVerifiedUser();
    }

    match /academy_lessons/{lessonId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /academy_checklists/{checklistId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
