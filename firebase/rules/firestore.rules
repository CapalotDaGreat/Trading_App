rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedUser() {
      return isSignedIn()
        && request.auth.token.email_verified == true;
    }

    function hasValidTimestamps() {
      return request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidUniverse(universe) {
      return universe is list
        && universe.size() >= 3
        && universe.size() <= 5
        && universe[0] is string && universe[0].size() >= 1 && universe[0].size() <= 20
        && universe[1] is string && universe[1].size() >= 1 && universe[1].size() <= 20
        && universe[2] is string && universe[2].size() >= 1 && universe[2].size() <= 20
        && (universe.size() < 4 || (universe[3] is string && universe[3].size() >= 1 && universe[3].size() <= 20))
        && (universe.size() < 5 || (universe[4] is string && universe[4].size() >= 1 && universe[4].size() <= 20));
    }

    function isValidPreferences(data) {
      return data is map
        && (!('timeBudgetMinutes' in data) || data.timeBudgetMinutes in [10, 20, 30, 45])
        && (!('activationGoal' in data) || data.activationGoal in [
          'research_more_selectively',
          'build_decision_discipline',
          'improve_review_habit'
        ])
        && (!('selectedUniverse' in data) || isValidUniverse(data.selectedUniverse));
    }

    function isValidUserProfile() {
      let data = request.resource.data;
      return data.keys().hasAll(['email', 'displayName', 'createdAt', 'updatedAt'])
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && !('fcmTokens' in data)
        && !('removedPushToken' in data)
        && !('pushTokenUpdatedAt' in data)
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 500))
        && (!('currency' in data) || (data.currency is string && data.currency.size() == 3))
        && (!('timezone' in data) || data.timezone is string)
        && (!('experienceLevel' in data) || data.experienceLevel in ['beginner', 'intermediate', 'advanced', 'professional'])
        && (!('notificationsEnabled' in data) || data.notificationsEnabled is bool)
        && (!('mfaEnabled' in data) || data.mfaEnabled is bool)
        && (!('onboardingCompleted' in data) || data.onboardingCompleted is bool)
        && (!('preferences' in data) || isValidPreferences(data.preferences));
    }

    function isValidWatchlist() {
      let data = request.resource.data;
      return data.keys().hasAll(['name', 'symbols', 'createdAt', 'updatedAt'])
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 100
        && data.symbols is list
        && data.symbols.size() <= 100;
    }

    function isValidHoldingIdentity(data) {
      return data.symbol is string
        && data.symbol.size() >= 1
        && data.symbol.size() <= 24
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 120
        && data.marketType in ['stocks', 'forex', 'crypto', 'commodities', 'indices', 'options']
        && data.assetClass in [
          'equity', 'etf', 'crypto', 'forex', 'commodity', 'metal',
          'index', 'option', 'bond', 'futures'
        ]
        && data.currency is string
        && data.currency.size() == 3
        && data.side in ['long', 'short']
        && data.instrumentId is string
        && data.instrumentId.size() >= 3
        && data.instrumentId.size() <= 64
        && data.canonicalSymbol is string
        && data.canonicalSymbol.size() >= 1
        && data.canonicalSymbol.size() <= 24
        && data.provider is string
        && data.provider in [
          'finnhub', 'alpha-vantage', 'coingecko', 'exchange-rate-api', 'internal', 'other'
        ]
        && data.providerSymbol is string
        && data.providerSymbol.size() >= 1
        && data.providerSymbol.size() <= 24;
    }

    function isValidHoldingCreate() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'symbol', 'name', 'marketType', 'assetClass', 'quantity',
          'averageCost', 'currentPrice', 'currency', 'side',
          'instrumentId', 'canonicalSymbol', 'provider', 'providerSymbol',
          'createdAt', 'updatedAt'
        ])
        && isValidHoldingIdentity(data)
        && data.quantity is number
        && data.quantity > 0
        && data.averageCost is number
        && data.averageCost >= 0
        && data.currentPrice is number
        && data.currentPrice > 0;
    }

    /** Lot fields only — instrument identity is immutable after create. */
    function isValidHoldingUpdate() {
      let data = request.resource.data;
      let prev = resource.data;
      return data.quantity is number
        && data.quantity > 0
        && data.averageCost is number
        && data.averageCost >= 0
        && data.currentPrice is number
        && data.currentPrice >= 0
        && data.symbol == prev.symbol
        && data.name == prev.name
        && data.marketType == prev.marketType
        && data.assetClass == prev.assetClass
        && data.currency == prev.currency
        && data.side == prev.side
        && (!('instrumentId' in prev) || data.instrumentId == prev.instrumentId)
        && (!('canonicalSymbol' in prev) || data.canonicalSymbol == prev.canonicalSymbol)
        && (!('provider' in prev) || data.provider == prev.provider)
        && (!('providerSymbol' in prev) || data.providerSymbol == prev.providerSymbol);
    }

    function isValidJournalEntry() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'symbol', 'direction', 'entryPrice', 'quantity', 'outcome',
          'tags', 'notes', 'tradedAt', 'createdAt', 'updatedAt'
        ])
        && data.symbol is string
        && data.symbol.size() >= 1
        && data.symbol.size() <= 20
        && data.direction in ['long', 'short']
        && data.entryPrice is number
        && data.entryPrice >= 0
        && data.quantity is number
        && data.quantity > 0
        && data.outcome in ['win', 'loss', 'breakeven', 'open']
        && data.tags is list
        && data.tags.size() <= 20
        && data.notes is string
        && data.notes.size() <= 10000
        && data.tradedAt is string;
    }

    function isValidAlert() {
      let data = request.resource.data;
      return data.keys().hasAll(['symbol', 'condition', 'targetPrice', 'isActive', 'createdAt', 'updatedAt'])
        && data.symbol is string
        && data.symbol.size() >= 1
        && data.symbol.size() <= 20
        && data.condition in ['above', 'below', 'crosses']
        && data.targetPrice is number
        && data.targetPrice > 0
        && data.isActive is bool;
    }

    function isValidDecisionRecord() {
      let data = request.resource.data;
      return data.keys().hasAll(['symbol', 'regime', 'action', 'createdAt'])
        && data.symbol is string
        && data.symbol.size() >= 1
        && data.symbol.size() <= 20
        && data.regime is string
        && data.regime.size() <= 100
        && data.action in [
          'researched', 'skipped', 'journaled', 'opened', 'viewed', 'ignored',
          'invalidated', 'completed', 'brief_opened', 'alert_triggered',
          'portfolio_reviewed', 'ai_opened', 'replay_completed',
          'checklist_done', 'lab_opened', 'lab_closed'
        ]
        && data.createdAt is timestamp
        && (!('note' in data) || (data.note is string && data.note.size() <= 2000));
    }

    function isValidUserSettings() {
      let data = request.resource.data;
      return data.keys().hasAll(['theme', 'updatedAt'])
        && data.theme in ['light', 'dark', 'system']
        && (!('hasCompletedOnboarding' in data) || data.hasCompletedOnboarding is bool)
        && (!('preferences' in data) || isValidPreferences(data.preferences))
        && data.updatedAt is timestamp;
    }

    function isValidDevice() {
      let data = request.resource.data;
      return data.keys().hasOnly(['deviceId', 'token', 'platform', 'deviceName', 'updatedAt'])
        && data.keys().hasAll(['deviceId', 'token', 'platform', 'deviceName', 'updatedAt'])
        && data.deviceId is string
        && data.deviceId.size() >= 16
        && data.deviceId.size() <= 128
        && data.token is string
        && data.token.size() >= 10
        && data.token.size() <= 4096
        && data.platform in ['ios', 'android', 'web']
        && (data.deviceName == null || (data.deviceName is string && data.deviceName.size() <= 200))
        && data.updatedAt is timestamp;
    }

    function isIsoCurrency(value) {
      return value is string && value.matches('^[A-Z]{3}$');
    }

    function isValidSimulationAccount(ownerId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'id', 'accountId', 'userId', 'mode', 'currency', 'startingBalance',
          'cashBalance', 'equity', 'status', 'createdAt', 'updatedAt'
        ])
        && data.id is string
        && data.accountId is string
        && data.id == data.accountId
        && data.userId == ownerId
        && data.userId == request.auth.uid
        && isIsoCurrency(data.currency)
        && data.mode in ['beginner', 'standard', 'challenge']
        && data.status in ['active', 'archived', 'challenge_failed']
        && data.startingBalance is number
        && data.startingBalance > 0
        && data.cashBalance is number
        && data.cashBalance >= 0
        && data.equity is number;
    }

    function isValidSimulationTransaction() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'id', 'accountId', 'timestamp', 'symbol', 'assetType', 'side',
          'quantity', 'executionPrice', 'grossValue', 'fees', 'netValue',
          'resultingCashBalance', 'resultingPositionQuantity'
        ])
        && data.id is string
        && data.accountId is string
        && data.symbol is string
        && data.symbol.size() >= 1
        && data.symbol.size() <= 24
        && data.assetType is string
        && data.assetType.size() >= 2
        && data.assetType.size() <= 32
        && data.side in ['buy', 'sell']
        && data.quantity is number
        && data.quantity > 0
        && data.executionPrice is number
        && data.executionPrice > 0
        && data.grossValue is number
        && data.fees is number
        && data.fees >= 0
        && data.netValue is number
        && data.resultingCashBalance is number
        && data.resultingCashBalance >= 0
        && data.resultingPositionQuantity is number
        && data.resultingPositionQuantity >= 0;
    }

    function isValidLearnerEvidence(ownerId) {
      let data = request.resource.data;
      return data.uid == ownerId
        && data.uid == request.auth.uid
        && data.eventKey is string
        && data.eventKey.size() >= 8
        && data.eventKey.size() <= 700
        && data.conceptId is string
        && data.conceptId.size() >= 1
        && data.conceptId.size() <= 80
        && data.sourceType in [
          'lesson_completion', 'knowledge_check', 'calculation_exercise', 'practice_drill',
          'applied_exercise', 'event_exercise', 'replay_decision', 'simulation_decision',
          'simulation_checkpoint', 'journal_reflection', 'review_finding',
          'remediation_exercise', 're_demonstration', 'transfer_exercise', 'surprise_assessment'
        ]
        && data.sourceId is string
        && data.sourceId.size() >= 1
        && data.sourceId.size() <= 120
        && data.occurredAt is number
        && data.result in ['pass', 'fail', 'partial', 'observed']
        && !('notes' in data)
        && !('lessonsLearned' in data)
        && !('prompt' in data)
        && !('equity' in data)
        && !('cashBalance' in data)
        && !('simulatedPnl' in data)
        && (!('processMetrics' in data) || (
          !('simulatedPnl' in data.processMetrics)
          && !('simulatedProfitable' in data.processMetrics)
        ));
    }

    function isValidLearnerProgress(ownerId) {
      let data = request.resource.data;
      return data.uid == ownerId
        && data.uid == request.auth.uid
        && data.schemaVersion is number
        && data.schemaVersion == 1
        && data.revision is number
        && data.updatedAt is number
        && data.academy is map
        && data.queue is map
        && data.replay is map
        && !('notes' in data)
        && !('lessonsLearned' in data)
        && !('prompt' in data)
        && !('equity' in data)
        && !('cashBalance' in data);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isVerifiedUser() && isValidUserProfile() && hasValidTimestamps();
      allow update: if isOwner(userId) && isVerifiedUser() && isValidUserProfile();
      allow delete: if isOwner(userId) && isVerifiedUser();

      match /devices/{deviceId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isVerifiedUser()
          && request.resource.data.deviceId == deviceId
          && isValidDevice();
        allow delete: if isOwner(userId) && isVerifiedUser();
      }

      match /watchlists/{watchlistId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isVerifiedUser() && isValidWatchlist() && hasValidTimestamps();
        allow update: if isOwner(userId) && isVerifiedUser() && isValidWatchlist();
        allow delete: if isOwner(userId) && isVerifiedUser();
      }

      match /holdings/{positionId} {
        allow read: if isOwner(userId);
        // Creates go through createPortfolioHolding callable (Admin SDK).
        // Keep a strict create shape for verified clients as defense-in-depth.
        allow create: if isOwner(userId) && isVerifiedUser() && isValidHoldingCreate() && hasValidTimestamps();
        allow update: if isOwner(userId) && isVerifiedUser() && isValidHoldingUpdate();
        allow delete: if isOwner(userId) && isVerifiedUser();
      }

      match /journal/{entryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isVerifiedUser() && isValidJournalEntry() && hasValidTimestamps();
        allow update: if isOwner(userId) && isVerifiedUser() && isValidJournalEntry();
        allow delete: if isOwner(userId) && isVerifiedUser();
      }

      match /alerts/{alertId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isVerifiedUser() && isValidAlert() && hasValidTimestamps();
        allow update: if isOwner(userId) && isVerifiedUser() && isValidAlert();
        allow delete: if isOwner(userId) && isVerifiedUser();
      }

      match /decisionLog/{recordId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isVerifiedUser() && isValidDecisionRecord();
        allow update, delete: if false;
      }

      match /simulationAccounts/{accountId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isVerifiedUser() && isValidSimulationAccount(userId) && hasValidTimestamps();
        allow update: if isOwner(userId) && isVerifiedUser() && isValidSimulationAccount(userId)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.userId == request.auth.uid;
        allow delete: if isOwner(userId) && isVerifiedUser();

        match /transactions/{txnId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId) && isVerifiedUser() && isValidSimulationTransaction()
            && request.resource.data.accountId == accountId;
          allow update, delete: if false;
        }

        match /positions/{positionId} {
          allow read: if isOwner(userId);
          allow create, update, delete: if isOwner(userId) && isVerifiedUser();
        }

        match /orders/{orderId} {
          allow read: if isOwner(userId);
          allow create, update: if isOwner(userId) && isVerifiedUser();
          allow delete: if false;
        }

        match /challenges/{challengeRunId} {
          allow read: if isOwner(userId);
          allow create, update: if isOwner(userId) && isVerifiedUser();
          allow delete: if false;
        }

        match /history/{archiveId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId) && isVerifiedUser() && isValidSimulationAccount(userId)
            && request.resource.data.status == 'archived'
            && hasValidTimestamps();
          allow update, delete: if false;
        }
      }

      match /learnerState/{docId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isVerifiedUser()
          && docId == 'progress'
          && isValidLearnerProgress(userId);
        allow delete: if isOwner(userId) && isVerifiedUser();
      }

      match /learnerEvidence/{eventKey} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isVerifiedUser() && isValidLearnerEvidence(userId);
        allow update: if isOwner(userId)
          && isVerifiedUser()
          && isValidLearnerEvidence(userId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.eventKey == resource.data.eventKey;
        allow delete: if isOwner(userId) && isVerifiedUser();
      }
    }

    match /subscriptions/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Server-owned daily usage ledger (Cloud Functions only).
    match /usage/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;

      match /daily/{dayId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /burst/{windowId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // Abuse / security telemetry — admin/Functions only.
    match /securityEvents/{eventId} {
      allow read, write: if false;
    }

    // Ops platform — Cloud Functions / Admin SDK only (no client user access).
    match /ops/{document=**} {
      allow read, write: if false;
    }

    // Internal ops admin allowlist — readable by the signed-in admin doc owner only.
    match /opsAdmins/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /userSettings/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isVerifiedUser() && isValidUserSettings();
      allow delete: if isOwner(userId) && isVerifiedUser();
    }

    match /academy_lessons/{lessonId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /academy_checklists/{checklistId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
